# Copia este archivo a .env.local para probar en tu PC. En Vercel, estas mismas variables van en
# Settings > Environment Variables (NUNCA con el prefijo NEXT_PUBLIC_: así quedan solo en el servidor).

# Dirección del backend (Render), sin "/" al final y sin /api
BACKEND_URL=https://kipiweb-backend-va.onrender.com

# El mismo valor que OWNER_API_TOKEN del backend (mínimo 32 caracteres)
OWNER_API_TOKEN=

# Contraseña para entrar al panel desde el navegador (mínimo 12 caracteres). Distinta del token.
PANEL_PASSWORD=

# Secreto para firmar la sesión (mínimo 32 caracteres aleatorios). Generar con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
PANEL_SESSION_SECRET=
